import sys
import os
import importlib
import numpy as np
import matplotlib.pyplot as plt

sys.path.append(os.path.abspath('../src'))

import range_engine
from data_access import hf_client
importlib.reload(hf_client)
importlib.reload(range_engine)

print("Downloading frame from Hugging Face...")
raw_frame = hf_client.get_frame(0) 


raw_cube = raw_frame[:, :, :, 0].transpose(2, 1, 0)
print(f"Matrix Shape ready for processing: {raw_cube.shape}")

fft_out, range_axis = range_engine.process_range_fft(
    raw_cube=raw_cube, 
    Tc=1e-4, 
    B=150e6, 
    window_type='hann'
)


plt.figure(figsize=(10, 4))
spectrum_db = 20 * np.log10(np.abs(fft_out[0, 0, :]))  # Channel 0, Chirp 0
plt.plot(range_axis, spectrum_db, color='b', linewidth=1.5)

plt.title("Real FMCW Radar Data - Range Spectrum")
plt.xlabel("Distance (Meters)")
plt.ylabel("Magnitude (dB)")
plt.grid(True)
plt.show()
